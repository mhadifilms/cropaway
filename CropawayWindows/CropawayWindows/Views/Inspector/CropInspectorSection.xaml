<UserControl x:Class="CropawayWindows.Views.Inspector.CropInspectorSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="250">

    <StackPanel>
        <!-- Current Mode Display -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Mode:" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CropModeDisplay}" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </DockPanel>

        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8" />

        <!-- Rectangle Fields -->
        <StackPanel x:Name="RectangleFields" Visibility="Collapsed">
            <!-- X -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="X:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="50" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding RectX, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <!-- Y -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Y:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="50" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding RectY, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <!-- Width -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Width:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="50" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding RectWidth, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <!-- Height -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Height:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="50" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding RectHeight, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <TextBlock Text="Normalized 0-1 coordinates" Foreground="{StaticResource TextTertiaryBrush}"
                       FontSize="10" FontStyle="Italic" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Circle Fields -->
        <StackPanel x:Name="CircleFields" Visibility="Collapsed">
            <!-- Center X -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Center X:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="60" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding CircleCenterX, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <!-- Center Y -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Center Y:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="60" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding CircleCenterY, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <!-- Radius -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Radius:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Width="60" />
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="11" Padding="4,2"
                         Text="{Binding CircleRadius, StringFormat={}{0:F4}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="OnNumericKeyDown" />
            </DockPanel>
            <TextBlock Text="Normalized 0-1 coordinates" Foreground="{StaticResource TextTertiaryBrush}"
                       FontSize="10" FontStyle="Italic" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Freehand Fields -->
        <StackPanel x:Name="FreehandFields" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Vertices:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FreehandVertexCount}" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
            <Button Style="{StaticResource ToolbarButton}" Content="Clear Mask"
                    Command="{Binding ClearFreehandCommand}"
                    HorizontalAlignment="Left" Margin="0,4,0,0"
                    Padding="8,4" FontSize="11" />
        </StackPanel>

        <!-- AI Fields -->
        <StackPanel x:Name="AIFields" Visibility="Collapsed">
            <!-- Text Prompt -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Prompt:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Top" Width="60" />
                <TextBlock Text="{Binding AiTextPrompt, TargetNullValue='(none)'}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="11" TextWrapping="Wrap" />
            </DockPanel>
            <Separator Background="{StaticResource BorderBrush}" Margin="0,4" />
            <!-- Bounding Box -->
            <TextBlock Text="Bounding Box" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="X:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" Width="50" />
                <TextBlock Text="{Binding AiBboxX, StringFormat={}{0:F4}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Y:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" Width="50" />
                <TextBlock Text="{Binding AiBboxY, StringFormat={}{0:F4}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Width:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" Width="50" />
                <TextBlock Text="{Binding AiBboxWidth, StringFormat={}{0:F4}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Height:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" Width="50" />
                <TextBlock Text="{Binding AiBboxHeight, StringFormat={}{0:F4}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
            </DockPanel>
            <Separator Background="{StaticResource BorderBrush}" Margin="0,4" />
            <!-- Confidence -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Confidence:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AiConfidence, StringFormat={}{0:P1}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
