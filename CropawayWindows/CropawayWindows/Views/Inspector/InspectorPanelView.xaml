<UserControl x:Class="CropawayWindows.Views.Inspector.InspectorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:CropawayWindows.Views.Inspector"
             mc:Ignorable="d"
             d:DesignWidth="250" d:DesignHeight="600"
             Width="250">

    <UserControl.Resources>
        <!-- Expander style for dark theme -->
        <Style x:Key="InspectorExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- Header -->
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand" Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="10,7">
                                            <DockPanel>
                                                <TextBlock x:Name="Arrow" Text="&#x25BC;" FontSize="9"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background"
                                                        Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{TemplateBinding Header}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </ToggleButton>

                            <!-- Content -->
                            <Border x:Name="ContentBorder" Padding="10,8"
                                    Visibility="Visible">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ContentBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Panel Header -->
            <Border Background="{StaticResource SurfaceBrush}" Padding="10,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="Inspector" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleVisibilityCommand}"
                            ToolTip="Close Inspector"
                            HorizontalAlignment="Right"
                            Padding="4,2" FontSize="10">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Section 1: Crop Inspector -->
            <Expander Header="Crop" Style="{StaticResource InspectorExpander}">
                <inspector:CropInspectorSection DataContext="{Binding}" />
            </Expander>

            <!-- Section 2: Transform Inspector -->
            <Expander Header="Transform" Style="{StaticResource InspectorExpander}">
                <inspector:TransformInspectorSection DataContext="{Binding}" />
            </Expander>

            <!-- Section 3: Audio Inspector -->
            <Expander Header="Audio" Style="{StaticResource InspectorExpander}">
                <inspector:AudioInspectorSection DataContext="{Binding}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
