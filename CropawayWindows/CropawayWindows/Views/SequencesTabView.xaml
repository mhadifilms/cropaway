<UserControl x:Class="CropawayWindows.Views.SequencesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CropawayWindows.ViewModels"
             xmlns:models="clr-namespace:CropawayWindows.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TimelineViewModel}"
             Background="{StaticResource SidebarBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header with count and add button -->
            <RowDefinition Height="Auto" />
            <!-- Sequence list -->
            <RowDefinition Height="*" />
            <!-- New Sequence button -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Sequences" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           Text="{Binding Timelines.Count, StringFormat='{}{0} items'}" />
            </DockPanel>
        </Border>

        <!-- Sequence List -->
        <ListBox Grid.Row="1"
                 Style="{StaticResource DarkListBox}"
                 ItemsSource="{Binding Timelines}"
                 SelectedItem="{Binding ActiveTimeline, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Padding="6,4" Margin="2,1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{StaticResource SelectedBrush}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Timeline}">
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <!-- Timeline icon -->
                            <ColumnDefinition Width="36" />
                            <!-- Info -->
                            <ColumnDefinition Width="*" />
                            <!-- Delete button -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Timeline icon -->
                        <Border Grid.Column="0" Width="36" Height="36"
                                CornerRadius="3" ClipToBounds="True"
                                Background="{StaticResource PanelBrush}">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="{StaticResource IconTimeline}"
                                       FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>

                        <!-- Sequence info -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <!-- Name (editable on double-click) -->
                            <TextBlock x:Name="NameDisplay"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="120"
                                       MouseLeftButtonDown="OnNameDoubleClick" />
                            <TextBox x:Name="NameEditor"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     FontSize="12" Padding="2,1"
                                     Visibility="Collapsed"
                                     LostFocus="OnNameEditorLostFocus"
                                     KeyDown="OnNameEditorKeyDown" />

                            <!-- Clip count + Duration -->
                            <TextBlock FontSize="10" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} clip(s)  {1}">
                                        <Binding Path="ClipCount" />
                                        <Binding Path="DurationDisplay" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Delete button -->
                        <Button Grid.Column="2" Style="{StaticResource SidebarIconButton}"
                                Click="OnDeleteSequenceClick"
                                ToolTip="Delete Sequence"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="{StaticResource IconDelete}"
                                       FontSize="12" />
                        </Button>

                        <!-- Context menu -->
                        <Grid.ContextMenu>
                            <ContextMenu Background="{StaticResource SurfaceBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="Rename"
                                          Click="OnRenameClick">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="&#xE8AC;"
                                                   FontSize="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Duplicate"
                                          Click="OnDuplicateClick">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="{StaticResource IconCopy}"
                                                   FontSize="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{StaticResource BorderBrush}" />
                                <MenuItem Header="Delete"
                                          Click="OnDeleteContextClick">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   Text="{StaticResource IconDelete}"
                                                   FontSize="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state (visible when no sequences) -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    x:Name="EmptyStatePanel"
                    Visibility="{Binding Timelines.Count, Converter={StaticResource ZeroToVisConverter}}">
            <TextBlock FontFamily="Segoe Fluent Icons" Text="{StaticResource IconTimeline}"
                       FontSize="32" Foreground="{StaticResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="No sequences" FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock Text="Create one to get started" FontSize="11"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <!-- New Sequence Button -->
        <Border Grid.Row="2" Padding="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Style="{StaticResource AccentButton}"
                    Command="{Binding CreateTimelineCommand}"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                               Text="{StaticResource IconAdd}"
                               FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="New Sequence" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
